APP_NAME="Piko Technology Services"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# DPO Pay (3G Direct Pay) – used by /payments
# The token below is DPO's TEST token. Swap in your LIVE token once
# DPO approves the account. Service types 54841 / 85325 are test codes.
# ---------------------------------------------------------------
DPO_COMPANY_TOKEN=B3F59BE7-0756-420E-BB88-1D98E7A6B040
DPO_API_ENDPOINT=https://secure.3gdirectpay.com/API/v6/
DPO_PAYMENT_URL=https://secure.3gdirectpay.com/payv3.php?ID=
DPO_CURRENCY=ZMW
DPO_DEFAULT_SERVICE_TYPE=85325
# Leave blank to use this app's own /payments/success and /payments/cancel URLs
DPO_REDIRECT_URL=
DPO_BACK_URL=

# ---------------------------------------------------------------
# Lenco – used by PikoPay (/pikopay) and Digital Impact donations
# ---------------------------------------------------------------
LENCO_PUBLIC_KEY=
LENCO_SECRET_KEY=
LENCO_API_BASE=https://api.lenco.co/access/v2

# ---------------------------------------------------------------
# ZamPayroll subscriptions (/zampayroll-subscriptions)
# ---------------------------------------------------------------
DPO_ZAMPAYROLL_SERVICE_TYPE=117535
ZAMPAYROLL_ADMIN_EMAIL=bupe@pikozm.com
# Admin payment emails need a real mailer. Example for a pikozm.com mailbox:
# MAIL_MAILER=smtp
# MAIL_HOST=mail.pikozm.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=billing@pikozm.com
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=billing@pikozm.com
# MAIL_FROM_NAME="ZamPayroll Billing"
